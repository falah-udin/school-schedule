💻 3. Kode Kunci
3.1. AJAX Request dengan Timeout
javascript

$.ajax({
    url: '/admin/generates/submit',
    method: 'GET',
    data: { kromosom: 1, generasi: 1, crossover: 0.5, mutasi: 0.1 },
    timeout: 30000,  // 30 detik (cukup untuk tahu gagal/berhasil)
    success: function(response) {
        // Jika berhasil dalam 30 detik → langsung redirect
        window.location.href = response.redirect;
    },
    error: function(xhr) {
        // Jika timeout → mulai polling
        if (xhr.status === 504 || xhr.status === 0) {
            startPolling();
        }
    }
});

3.2. Fungsi Polling
javascript

function startPolling() {
    let pollCount = 0;
    
    checkInterval = setInterval(function() {
        pollCount++;
        
        $.get('/admin/generates/check', function(data) {
            // data.total = jumlah jadwal di database
            if (data.total > 0) {
                clearInterval(checkInterval);
                showResult(data);  // Tampilkan notifikasi
            }
        });
        
        // Timeout polling setelah 5 menit (60 × 5 = 300 detik)
        if (pollCount > 60) {
            clearInterval(checkInterval);
            alert('Proses memakan waktu lama, silakan cek nanti');
        }
    }, 5000);  // Setiap 5 detik
}

3.3. Endpoint Check (Backend)
php

public function checkSchedule()
{
    // Hitung target per kromosom
    $teachs = Teach::with('course')->get();
    $targetPerKromosom = 0;
    foreach ($teachs as $teach) {
        $targetPerKromosom += $teach->course->hours_per_week;
    }
    
    // Statistik per kromosom
    $kromosomTypes = Schedule::select('type')
        ->groupBy('type')
        ->orderBy('type', 'asc')
        ->get();
    
    $kromosomStats = [];
    foreach ($kromosomTypes as $type) {
        $count = Schedule::where('type', $type->type)->count();
        $kromosomStats[] = [
            'type' => $type->type,
            'count' => $count,
            'target' => $targetPerKromosom,
            'percentage' => round(($count / $targetPerKromosom) * 100)
        ];
    }
    
    return response()->json([
        'total' => Schedule::count(),
        'target_per_kromosom' => $targetPerKromosom,
        'kromosom_stats' => $kromosomStats
    ]);
}

