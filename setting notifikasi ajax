4.2. JavaScript Lengkap
javascript

let checkInterval = null;
let currentProcessId = null;

// 1. KIRIM REQUEST
function startProcess() {
    // Tampilkan loading
    $('#loading-modal').show();
    addLog('Memulai proses...', 'info');
    
    $.ajax({
        url: '/api/process/submit',
        method: 'POST',
        data: { param1: value1, param2: value2 },
        timeout: 30000,  // 30 detik
        success: function(response) {
            // Jika langsung selesai (<30 detik)
            if (response.completed) {
                showResult(response);
            } else {
                // Mulai polling
                currentProcessId = response.process_id;
                startPolling();
            }
        },
        error: function(xhr) {
            // Timeout atau error, tetap mulai polling
            addLog('Request timeout, memeriksa status...', 'warning');
            startPollingWithLastId();
        }
    });
}

// 2. POLLING STATUS
function startPolling() {
    let pollCount = 0;
    
    checkInterval = setInterval(function() {
        pollCount++;
        
        $.get('/api/process/status/' + currentProcessId, function(data) {
            // Update UI
            updateProgress(data.progress);
            addLog(data.message, 'info');
            
            // Cek selesai
            if (data.status === 'completed') {
                clearInterval(checkInterval);
                showResult(data);
            }
            
            // Cek gagal
            if (data.status === 'failed') {
                clearInterval(checkInterval);
                showError(data.message);
            }
            
        }).fail(function() {
            addLog('Gagal cek status, mencoba lagi...', 'warning');
        });
        
        // Timeout polling (misal 5 menit)
        if (pollCount > 60) {
            clearInterval(checkInterval);
            addLog('Proses terlalu lama, silakan cek nanti', 'error');
        }
        
    }, 5000);  // Setiap 5 detik
}

// 3. FUNGSI PENDUKUNG
function addLog(message, type) {
    let logClass = type || 'info';
    let time = new Date().toLocaleTimeString();
    $('#log-box').append(`<div class="${logClass}">[${time}] ${message}</div>`);
    $('#log-box').scrollTop($('#log-box')[0].scrollHeight);
}

function updateProgress(percent) {
    $('.progress-fill').css('width', percent + '%');
}

function showResult(data) {
    $('#loading-modal').hide();
    alert('Proses selesai! Hasil: ' + data.result);
}

function showError(message) {
    $('#loading-modal').hide();
    alert('Error: ' + message);
}

